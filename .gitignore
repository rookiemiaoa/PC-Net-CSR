# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ---- 虚拟环境 ----
.venv/
venv/
env/
ENV/

# ---- 大体积数据（不入库，见 README §3.2） ----
*.hdf5
*.h5
# 模型权重不入库：7 个 model-best.pt 合计约 170 MB（162.7 MiB），按需从发布页/网盘下载。
# 其余小体积 json / pkl 仍入库（复现需要），不要删除。
checkpoints/**/*.pt

# ---- 运行时产物 ----
csr/outputs/
csr/analysis/figures/
csr/**/figures/
w4x_check/

# ---- 日志 ----
# 注意：checkpoints/ 与 results/ 下的 .log 是论文附录 A.5 引用的原始证据，
# 必须入库；只忽略仓库根目录的临时日志。
/*.log
!checkpoints/**/*.log
!results/**/*.log
# 但 results/ 顶层的日志是 `reproduce.sh check` 每次运行都会重写的运行时输出，
# 不是证据（证据日志都在 results/multiseed/ 与 results/oracle_bounds/ 子目录里），
# 不入库，否则自检一次就把工作区弄脏。
/results/*.log

# ---- 编辑器 / 系统 ----
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
~$*
